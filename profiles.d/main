# Sourced from ~/.zshrc (interactive) and ~/.zlogin (login).
# Interactive login shells source both; load only once.
[[ -n ${ZSH_VERSION:-} ]] || return 0
# Same-process guard for ~/.zshrc + ~/.zlogin. Not exported: a nested
# interactive zsh still needs aliases, prompt, and widgets.
[[ -n ${MAIN_PROFILE_LOADED:-} ]] && return 0
MAIN_PROFILE_LOADED=1
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

# source "$XDG_CONFIG_HOME/profiles.d/term"
source "$XDG_CONFIG_HOME/profiles.d/env"
source "$XDG_CONFIG_HOME/profiles.d/alias"

if [[ -o interactive ]]; then
  source "$XDG_CONFIG_HOME/profiles.d/zsh"
  source "$XDG_CONFIG_HOME/profiles.d/fzf"
fi

work_profile="$XDG_CONFIG_HOME/profiles.d/work"
[[ -f "$work_profile" ]] && source "$work_profile"

local_profile="$XDG_CONFIG_HOME/profiles.d/local"
[[ -f "$local_profile" ]] && source "$local_profile"

if [[ -o interactive ]]; then
  [[ -f /usr/local/etc/profile.d/autojump.sh ]] && source /usr/local/etc/profile.d/autojump.sh
  [[ -f /usr/share/autojump/autojump.sh ]] && source /usr/share/autojump/autojump.sh
  [[ -f /opt/homebrew/etc/profile.d/autojump.sh ]] && source /opt/homebrew/etc/profile.d/autojump.sh
  [[ -f ~/.fzf.zsh ]] && source ~/.fzf.zsh
fi
